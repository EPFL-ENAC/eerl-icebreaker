# Backend settings (read by backend/api/config.py).
# Copy to .env at the repo root: cp .env.example .env

# API root path when served behind a proxy
#PATH_PREFIX=/api

# Keycloak: enac-it-sso2, shared realm EPFL_inside, app roles are client roles of the API client
#KEYCLOAK_REALM=EPFL_inside
#KEYCLOAK_URL=https://enac-it-sso2.epfl.ch
KEYCLOAK_API_ID=icebreaker-local-api
KEYCLOAK_API_SECRET=xxxxx

# S3 storage (endpoint = protocol + hostname)
S3_ENDPOINT_PROTOCOL=https://
S3_ENDPOINT_HOSTNAME=xxxxx
S3_ACCESS_KEY_ID=xxxxx
S3_SECRET_ACCESS_KEY=xxxxx
S3_REGION=xxxxx
S3_BUCKET=xxxxx
S3_PATH_PREFIX=xxxxx

# Redis cache (make run starts a local redis)
#REDIS_URL=redis://localhost
#CACHE_API_EXPIRY=3600
#CACHE_SOURCE_EXPIRY=3600

# Map API key served to the frontend
MAP_API_KEY=xxxxx
